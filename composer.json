{
    "name": "whostyles/whostyles-wordpress",
    "description": "WordPress plugin for Whostyles V1 (Hash Protocol) support",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Whostyles Contributors",
            "homepage": "https://github.com/whostyles"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^2.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^1.10",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Whostyles\\WordPress\\": "src/",
            "Whostyles\\": "src/Lib/"
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "security:audit": "composer audit",
        "semgrep": "semgrep scan --config=auto",
        "ci": [
            "@security:audit",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    }
}
